#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1
start_service() {
    [ "$(uci -q get mesh-backhaul.main.enabled)" = 1 ] || return 0
    [ -s /etc/mesh-control/backhaul/openvpn.conf ] && [ -x /usr/sbin/openvpn ] || return 1
    procd_open_instance vpn
    procd_set_param command /usr/sbin/mesh-backhaul-vpn
    procd_set_param respawn 3600 5 5
    procd_close_instance
    procd_open_instance monitor
    procd_set_param command /usr/sbin/mesh-backhaul
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 5
    procd_close_instance
}
service_triggers() { procd_add_reload_trigger mesh-backhaul; }
