#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1

start_service() {
	[ "$(cat /etc/mesh-control/role 2>/dev/null)" != controller ] || return 0
	[ -s /etc/config/mesh-control-agent ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/mesh-control-agent
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger mesh-control-agent
}
